{
  "name": "@gamepark/react-game",
  "version": "7.10.0",
  "type": "module",
  "description": "React components & tools to create a Board Game user interface for Game Park",
  "author": "Romain Fromi <romain@game-park.com> (https://game-park.com/)",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "check-sounds": "node scripts/check-sounds.mjs",
    "prepack": "yarn check-sounds && yarn build",
    "linkgp": "yarn link ../rules-api ../react-client -r && git update-index --skip-worktree package.json yarn.lock",
    "unlinkgp": "git update-index --no-skip-worktree package.json yarn.lock && yarn unlink ../react-client ../rules-api",
    "sync-sounds": "rclone sync sounds sounds:sounds.game-park.com --progress --s3-acl=public-read",
    "publish": "npm version ${0:-patch} && yarn npm publish && yarn sync-sounds && git push && git push --tags"
  },
  "dependencies": {
    "@datadog/browser-logs": "^7.17.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@gamepark/api-types": "^1.0.3",
    "@gamepark/avataaars": "^3.0.0",
    "@gamepark/react-client": "^7.10.0",
    "@trpc/server": "^11.25.0",
    "dayjs": "^1.11.23",
    "fscreen": "^1.2.0",
    "i18next-http-backend": "^4.0.10",
    "i18next-icu": "^2.7.0",
    "immer": "^11.2.9",
    "intl-messageformat": "^12.1.4",
    "nosleep.js": "^0.12.0",
    "o9n": "^2.1.1",
    "react-infinite-scroll-component": "^7.2.1",
    "react-merge-refs": "^3.0.2",
    "react-zoom-pan-pinch": "^4.2.0",
    "rxjs": "^7.8.2",
    "use-long-press": "^3.3.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@gamepark/rules-api": "^7.10.0",
    "@types/fscreen": "^1.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "es-toolkit": "^1.53.2",
    "i18next": "^27.0.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-redux": "^9.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "6.x",
    "@emotion/react": "11.x",
    "@fortawesome/fontawesome-svg-core": "7.x",
    "@fortawesome/free-regular-svg-icons": "7.x",
    "@fortawesome/free-solid-svg-icons": "7.x",
    "@fortawesome/react-fontawesome": "3.x",
    "@gamepark/rules-api": "^7.9.1",
    "es-toolkit": "1.x",
    "i18next": "27.x",
    "react": "19.x",
    "react-dom": "19.x",
    "react-i18next": "18.x",
    "react-redux": "9.x",
    "typescript": ">=5.7.2"
  },
  "packageManager": "yarn@4.18.0"
}
